{% assign tz_articles = rss.channel.item %}
{% if tz_articles == nil or tz_articles == empty %}{% assign tz_articles = channel.item %}{% endif %}
{% if tz_articles == nil or tz_articles == empty %}{% assign tz_articles = data.rss.channel.item %}{% endif %}
{% if tz_articles == nil or tz_articles == empty %}{% assign tz_articles = data.channel.item %}{% endif %}
{% if tz_articles == nil or tz_articles == empty %}{% assign tz_articles = data.item %}{% endif %}
{% if tz_articles == nil or tz_articles == empty %}{% assign tz_articles = items %}{% endif %}
{% assign tz_lead = tz_articles | first %}
<style>
  .tz-small { box-sizing: border-box; width: 100%; height: 100%; color: #111; font-family: Arial, Helvetica, sans-serif; }
  .tz-small-logo { font-size: 11px; line-height: 1; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; border-bottom: 2px solid #111; padding-bottom: 6px; }
  .tz-small-label { margin-top: 9px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
  .tz-small-title { margin: 8px 0 0; font-size: 18px; line-height: 1.16; font-weight: 800; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; overflow: hidden; }
</style>
<div class="layout"><div class="tz-small"><div class="tz-small-logo">Latest article</div><h2 class="tz-small-title">{{ tz_lead.title | escape }}</h2></div></div>
<div class="title_bar"><span class="title">Latest article</span></div>
