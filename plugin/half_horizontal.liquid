<style>
  .tz-compact { box-sizing: border-box; width: 100%; height: 100%; color: #111; font-family: Arial, Helvetica, sans-serif; }
  .tz-compact-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #111; padding-bottom: 6px; }
  .tz-compact-label { font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
  .tz-compact-list { display: flex; gap: 12px; padding-top: 11px; }
  .tz-compact-story { flex: 1 1 0; min-width: 0; border-right: 1px solid #111; padding-right: 12px; }
  .tz-compact-story:last-child { border-right: 0; padding-right: 0; }
  .tz-compact-number { font-size: 10px; font-weight: 800; margin-bottom: 5px; }
  .tz-compact-title { margin: 0; font-size: 17px; line-height: 1.15; font-weight: 800; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }
  .tz-compact-date { margin-top: 6px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
</style>
<div class="layout">
  <div class="tz-compact">
    <div class="tz-compact-head"><span class="tz-compact-label">Latest articles</span><span class="tz-compact-label">{{ 'now' | date: '%d %b' }}</span></div>
    <div class="tz-compact-list">
      {% for article in tz_articles limit:3 %}
      <div class="tz-compact-story"><div class="tz-compact-number">0{{ forloop.index }}</div><h2 class="tz-compact-title">{{ article.title | escape }}</h2><div class="tz-compact-date">{{ article.pubDate | date: '%d %b' }}</div></div>
      {% endfor %}
    </div>
  </div>
</div>
<div class="title_bar"><span class="title">Latest articles</span></div>
